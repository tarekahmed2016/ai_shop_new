APP_NAME=ai_shop_new
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Production recommendations:
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when serving the site over HTTPS in production.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WHATSAPP_DEFAULT_COUNTRY_CODE=968

# Merchant PWA Web Push (standards-based, not Firebase).
# Generate keys later with: php artisan webpush:vapid
# Do not put VAPID_PRIVATE_KEY in frontend code.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="${APP_URL}"


# Customer request AI classification. Tests use the fake provider.
# For OpenAI later: AI_CLASSIFICATION_PROVIDER=openai and OPENAI_API_KEY=
AI_CLASSIFICATION_PROVIDER=fake
AI_CLASSIFICATION_MODEL=gpt-5.6-sol
AI_CLASSIFICATION_REASONING_EFFORT=high
AI_CLASSIFICATION_IMAGE_DETAIL=original
AI_CLASSIFICATION_HIGH_CONFIDENCE=0.85
AI_CLASSIFICATION_MEDIUM_CONFIDENCE=0.60
AI_CLASSIFICATION_TIMEOUT=30
OPENAI_API_KEY=
