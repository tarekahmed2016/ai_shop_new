APP_NAME=ai_shop_new
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Production recommendations:
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Optional marketer referral cookie (defaults work without these).
# REFERRAL_COOKIE_NAME=ref_code
# REFERRAL_COOKIE_DAYS=30

# Set to true when serving the site over HTTPS in production.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Optional. Recipients processed per chunk when fan-out matched-request notifications (default 200).
# MATCHED_REQUEST_NOTIFICATION_CHUNK_SIZE=200

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WHATSAPP_DEFAULT_COUNTRY_CODE=968

# Merchant PWA Web Push (standards-based, not Firebase).
# Generate keys later with: php artisan webpush:vapid
# Do not put VAPID_PRIVATE_KEY in frontend code.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="${APP_URL}"


# Customer request AI classification. Tests use the fake provider.
# For OpenAI later: AI_CLASSIFICATION_PROVIDER=openai and OPENAI_API_KEY=
AI_CLASSIFICATION_PROVIDER=fake
AI_CLASSIFICATION_MODEL=gpt-5.6-sol
AI_CLASSIFICATION_REASONING_EFFORT=high
AI_CLASSIFICATION_IMAGE_DETAIL=original
AI_CLASSIFICATION_HIGH_CONFIDENCE=0.85
AI_CLASSIFICATION_MEDIUM_CONFIDENCE=0.60
AI_CLASSIFICATION_TIMEOUT=30
OPENAI_API_KEY=

# Duplicate commercial-need protection. Tests use the fake provider.
# CUSTOMER_REQUEST_DUPLICATE_CONFIDENCE=0.90
# AI_DUPLICATE_DETECTION_PROVIDER=fake
# AI_DUPLICATE_DETECTION_MODEL=gpt-5.6-sol
# AI_DUPLICATE_DETECTION_TIMEOUT=20

# --- Async AI pipeline (classification / duplicate-check / finalization) ---
#
# Rollout flag. Leave false until queue workers AND the scheduler cron
# below are confirmed healthy. Rollback = set back to false (no down
# migration). The legacy synchronous classify/confirm path stays in the
# codebase while this is false.
# CLASSIFICATION_ASYNC_ENABLED=false
#
# Classification, duplicate-check, and finalization jobs are dispatched on
# this dedicated queue name so they cannot starve (or be starved by) the
# matched-request notification fan-out on `default`.
#
# Matching (MatchCustomerRequestJob) and matched-request notification
# fan-out stay on `default`. They share the same worker; a second process
# or a third queue name is not required.
#
# A SECOND WORKER PROCESS IS NOT REQUIRED. One `queue:work` can listen to
# both queues; list the AI queue first so AI jobs are preferred:
#
#   Local:
#     php artisan queue:work --queue="${CUSTOMER_REQUEST_AI_QUEUE:-ai-processing},default"
#
#   Production (systemd/supervisor example):
#     php artisan queue:work --queue=ai-processing,default --sleep=1 --tries=3 --timeout=150
#
# Stuck recovery and idle-attempt expiry do NOT run just because a worker
# is up. Production MUST run Laravel's scheduler every minute:
#
#   crontab -e  (exact line for this host):
#     * * * * * cd /opt/lampp/htdocs/ai_shop_new && php artisan schedule:run >> /dev/null 2>&1
#
#   or a long-running process:
#     php artisan schedule:work
#
# That cron is what fires `php artisan customer-requests:recover-stuck-ai`
# every CUSTOMER_REQUEST_STUCK_AI_RECOVERY_EVERY_MINUTES minutes, and
# `php artisan customer-requests:recover-pending-matching` every
# CUSTOMER_REQUEST_MATCHING_RECOVERY_EVERY_MINUTES minutes. If cron is
# missing, stuck AI rows are never recovered, abandoned
# ready_for_review/failed rows are never expired, and a Ready request
# whose matching job was lost after commit is never rematched. One-off:
#     php artisan customer-requests:recover-stuck-ai
#     php artisan customer-requests:recover-pending-matching
#
# The same cron also runs daily retention (job_batches, failed_jobs,
# expired database cache/locks). One-off:
#     php artisan queue:prune-batches --hours=48
#     php artisan queue:prune-failed --hours=168
#     php artisan cache:prune-expired
CLASSIFICATION_ASYNC_ENABLED=false
CUSTOMER_REQUEST_AI_QUEUE=ai-processing
CUSTOMER_REQUEST_MAX_OPEN_AI_ATTEMPTS=5
CUSTOMER_REQUEST_OPEN_ATTEMPT_TTL_HOURS=48
CUSTOMER_REQUEST_STUCK_AI_THRESHOLD_MINUTES=3
CUSTOMER_REQUEST_STUCK_AI_MAX_RECOVERY_ATTEMPTS=3
CUSTOMER_REQUEST_STUCK_AI_RECOVERY_EVERY_MINUTES=5
CUSTOMER_REQUEST_MATCHING_RECOVERY_STALE_MINUTES=10
CUSTOMER_REQUEST_MATCHING_RECOVERY_EVERY_MINUTES=5
CUSTOMER_REQUEST_STATUS_POLL_INTERVAL_MS=1800
CUSTOMER_REQUEST_STATUS_POLL_TIMEOUT_MS=90000
CUSTOMER_REQUEST_STATUS_POLL_RETRY_MS=3000
CUSTOMER_REQUEST_DUPLICATE_NOTICE_TTL_SECONDS=86400

# Max distinct merchant contacts a customer may reveal per request (default 3).
# CUSTOMER_REQUEST_CONTACT_REVEAL_LIMIT=3

# Optional overlapping-concurrency suite against a dedicated MariaDB *test* database
# (never a production schema). SQLite WAL cannot prove InnoDB row-lock serialization.
#   bash scripts/run-concurrency-mariadb.sh
# CONCURRENCY_DB=mariadb
# CONCURRENCY_DB_HOST=127.0.0.1
# CONCURRENCY_DB_PORT=3306
# CONCURRENCY_DB_DATABASE=ai_shop_concurrency_test
# CONCURRENCY_DB_USERNAME=root
# CONCURRENCY_DB_PASSWORD=
